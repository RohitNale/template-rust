# ==========================================
# Rust / Cargo Outputs
# ==========================================
# The target directory contains all compiled binary outputs, dependencies, and build artifacts.
/target/

# Generated by Cargo when building documentation (`cargo doc`)
/doc/

# Backup files generated by `cargo fix`
**/*.rs.bk

# Cargo lockfile (Uncomment below ONLY if building a library instead of a binary/API application)
# Cargo.lock

# ==========================================
# Environment Variables & Secrets (Critical for Axum APIs)
# ==========================================
# Never commit your database credentials, API keys, or JWT secrets to Git.
.env
.env.local
.env.*.local

# Allow committing a template/example configuration file so other developers know what variables are required
!.env.example

# ==========================================
# Local Database / SQLx Cache (If using databases)
# ==========================================
# If you use SQLx for compile-time query validation, exclude local SQLite files
*.db
*.db-journal
*.db-shm
*.db-wal

# SQLx offline data (Keep this if you want `cargo build` to work without a database connection in CI/CD)
# !.sqlx/

# ==========================================
# Developer Environments / IDEs
# ==========================================
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json

# IntelliJ / RustRover
.idea/
*.iml

# macOS system files
.DS_Store
